<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="#F0F2F5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Profile Image -->
            <androidx.cardview.widget.CardView
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:cardCornerRadius="60dp"
                app:cardElevation="4dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#FFFFFF">

                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:scaleType="centerInside"
                    android:padding="25dp"
                    app:tint="#3F51B5"
                    android:contentDescription="Profile Picture"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/profileName"
                android:text="Vaishnavi"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:layout_marginTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/profileEmail"
                android:text="vaishnavi@example.com"
                android:textSize="15sp"
                android:textColor="#5C6BC0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Stats/Details Grid -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                android:backgroundTint="#FFFFFF">

                <GridLayout
                    android:padding="20dp"
                    android:columnCount="2"
                    android:rowCount="3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_columnWeight="1"
                        android:padding="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">
                        <TextView android:text="Age" android:textColor="#9FA8DA" android:textSize="12sp" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/valAge" android:text="65 yrs" android:textStyle="bold" android:textSize="18sp" android:textColor="#283593" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_columnWeight="1"
                        android:padding="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">
                        <TextView android:text="Blood" android:textColor="#9FA8DA" android:textSize="12sp" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/valBlood" android:text="O+" android:textStyle="bold" android:textSize="18sp" android:textColor="#D32F2F" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_columnWeight="1"
                        android:padding="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">
                        <TextView android:text="Weight" android:textColor="#9FA8DA" android:textSize="12sp" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/valWeight" android:text="70 kg" android:textStyle="bold" android:textSize="18sp" android:textColor="#283593" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_columnWeight="1"
                        android:padding="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">
                        <TextView android:text="Height" android:textColor="#9FA8DA" android:textSize="12sp" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/valHeight" android:text="165 cm" android:textStyle="bold" android:textSize="18sp" android:textColor="#283593" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_columnWeight="1"
                        android:padding="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">
                        <TextView android:text="Gender" android:textColor="#9FA8DA" android:textSize="12sp" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/valGender" android:text="Female" android:textStyle="bold" android:textSize="18sp" android:textColor="#283593" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                </GridLayout>
            </androidx.cardview.widget.CardView>

            <!-- Medical History -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                android:backgroundTint="#FFFFFF">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="Medical History"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1A237E"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/medicalHistory"
                        android:text="• Hypertension (Since 2018)\n• Type 2 Diabetes (Managed)"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="6dp"
                        android:textColor="#555555"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/editProfileBtn"
                android:text="Edit Profile"
                android:layout_marginTop="32dp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:cornerRadius="16dp"
                android:backgroundTint="#3F51B5"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/logoutBtn"
                android:text="Logout"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textAllCaps="false"
                android:textColor="#C62828"
                android:textSize="16sp"
                app:strokeColor="#C62828"
                app:strokeWidth="2dp"/>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:menu="@menu/bottom_menu"
        app:itemIconTint="@color/selector_color"
        app:itemTextColor="@color/selector_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:labelVisibilityMode="labeled"/>

</androidx.constraintlayout.widget.ConstraintLayout>