<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F6F8FB"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="New Emergency Contact"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#C62828"
        android:layout_marginBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="Contact Name"
        android:textColor="#333333"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <EditText
        android:id="@+id/contactNameInput"
        android:hint="e.g. Son, Daughter"
        android:padding="16dp"
        android:background="@drawable/edit_bg"
        android:layout_marginBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="Phone Number"
        android:textColor="#333333"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <EditText
        android:id="@+id/contactPhoneInput"
        android:hint="e.g. 9876543210"
        android:inputType="phone"
        android:padding="16dp"
        android:background="@drawable/edit_bg"
        android:layout_marginBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/saveContactBtn"
        android:text="Save Contact"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#C62828"
        android:padding="16dp"
        app:cornerRadius="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>